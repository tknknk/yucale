<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.tknknk.yucale</groupId>
    <artifactId>yucale-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yucale-backend</name>
    <description>Backend for Shared Calendar Application</description>

    <properties>
        <java.version>21</java.version>

        <!-- Spring Boot 4.1.1 が既定で引く版に既知CVEが残るため上書きする
             (2026-10-22 の依存監査、OSV.dev 照合)。いずれも同一マイナー系内の
             パッチ更新。Boot 本体が追いついた時点でこのブロックは削除し、
             親の管理に戻すこと。

               tomcat  11.0.24 -> 11.0.27  CVE-2026-65182 / 68525 / 65905
                 Tomcat 自身の認証・security-constraint 機構の不備で、本アプリは
                 Spring Security のフィルタチェーンのみを使うため直接の該当は
                 ない。1行で塞げるので予防的に上げている。

               jackson 3.1.5 -> 3.1.8  CVE-2026-89425 / 89407 / 91777 / 91776 ほか
                 これは実際に効く。/api/** の外部JSONがそのままパーサを通り、
                 上記はいずれもパース時のDoS系。ヒープ128m で回している本番では
                 2026-09-01 の OOM と同じ「落ちずに劣化し続ける」形になりうる。
                 Boot 4 は Jackson 3 (tools.jackson) が既定だが、BOMを指す
                 プロパティ名は 3 系でも jackson-bom.version のまま。

             postgresql は Boot 4.1.1 の既定が 42.7.13 で CVE-2026-54291
             (42.7.12 で修正) を外れているため、ここでの上書きは不要。 -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Boot 4 ではセッションストアも starter 経由になった
             (org.springframework.session の生アーティファクト直書きは非推奨)。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Rate Limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <!-- Holds the per-client rate-limit buckets. bucket4j-core has no store
             of its own, and a plain map of them never stops growing; see
             RateLimitFilter. Version is managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Testing -->
        <!-- Boot 4 ではテストも技術別 starter に分かれ、spring-boot-starter-test は
             これらから推移的に入る。@WebMvcTest は webmvc-test、@DataJpaTest は
             data-jpa-test、@WithMockUser は security-test が無いと動かない。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers は初回コミット以来どのテストからも参照されていなかった
             ため、Boot 4 移行 (2026-10-22) で削除した。テストDBは H2 で、
             src/test/resources/application-test.properties がそれを指している。
             Boot 4.1.1 が管理する Testcontainers 2.x では全モジュールが
             testcontainers-<module> に改名され、旧座標の org.testcontainers:postgresql /
             :junit-jupiter は BOM から消えているため、残すならどのみち座標の
             書き換えが要る。実際に使うときに新座標で足すこと。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
