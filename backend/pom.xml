<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.tknknk.yucale</groupId>
    <artifactId>yucale-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yucale-backend</name>
    <description>Backend for Shared Calendar Application</description>

    <properties>
        <java.version>21</java.version>

        <!-- Spring Boot 3.5.16 が既定で引く版に既知CVEが残るため上書きする
             (2026-10-21 の依存監査、OSV.dev 照合)。いずれも同一マイナー系内の
             パッチ更新なのでAPI互換。Boot 本体が追いついた時点でこのブロックは
             削除し、親の管理に戻すこと。

               tomcat     10.1.55 -> 10.1.61  CVE-2026-65182 / 68525 / 65905
                 いずれも Tomcat 自身の認証・security-constraint 機構の不備で、
                 本アプリは web.xml の security-constraint も Tomcat の
                 FORM/DIGEST authenticator も使わず Spring Security の
                 フィルタチェーンのみで認可しているため直接の該当はない。
                 1行で塞げるので予防的に上げている。

               jackson    2.21.4  -> 2.21.8   CVE-2026-89425 / 89407 / 91777 / 91776 / 68497 ほか
                 これは実際に効く。/api/** の外部JSONがそのまま jackson-core /
                 databind のパーサを通り、上記はいずれもパース時のDoS系
                 (無制限の StringBuilder 肥大、ReDoS、二次オーダーの
                 forward-reference 処理)。ヒープ128m・MaxMetaspace192m で
                 回している本番では、2026-09-01 の OOM と同じ「落ちずに
                 劣化し続ける」形になりうる。

               postgresql 42.7.11 -> 42.7.14  CVE-2026-54291
                 未対応の証明書アルゴリズム使用時に channel binding が無言で
                 ダウングレードされる。DB接続は同一Dockerネットワーク内なので
                 現状の実害は小さい。

               log4j2     2.24.3  -> 2.25.5   CVE-2026-49844
                 MapMessage のJSON化のみに影響。log4j-to-slf4j ブリッジ経由で
                 存在するだけで未使用。ついでの更新。 -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Rate Limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <!-- Holds the per-client rate-limit buckets. bucket4j-core has no store
             of its own, and a plain map of them never stops growing; see
             RateLimitFilter. Version is managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
