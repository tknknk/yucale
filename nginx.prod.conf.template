worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 10M;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # CloudFront がオリジンリクエストに付与する共有シークレットの検証。
    #
    # セキュリティグループは CloudFront のマネージドプレフィックスリストを許可する
    # が、これは「全AWSアカウントのCloudFront」を意味する。つまり第三者が自分の
    # ディストリビューションをこのEIPに向けるだけで、本来のCloudFrontを迂回して
    # オリジンに直接到達できてしまう。そのため共有シークレットで発信元を確認する。
    #
    # ORIGIN_VERIFY_SECRET が未設定なら envsubst で空文字に展開され、"" が
    # 「ヘッダー無し」にマッチして 1 になる = 検証が無効化されるだけで済む。
    # 設定漏れでサイト全体が403になるより安全側に倒している。
    map $http_x_origin_verify $origin_verified {
        default                   0;
        "${ORIGIN_VERIFY_SECRET}" 1;
    }

    # WebSocket のアップグレードを「クライアントが実際に要求した時だけ」中継する。
    # 以前は location / で Connection "upgrade" を固定していたため、全リクエストが
    # アップグレード要求としてNext.jsに渡っていた。Next 14 には WebSocket
    # アップグレードを使うアプリでの SSRF (GHSA-c4j6-fc7j-m34r, CVSS 8.6) が
    # 未修正のまま残っており、14系はもうパッチが出ない (2026-10-21 の依存監査)。
    # 本番の Next は standalone で HMR も無く WebSocket を一切使わないので、
    # 既定を close にして攻撃面を閉じる。
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream backend {
        server backend:8080;
    }

    upstream frontend {
        server frontend:3000;
    }

    server {
        listen 80;
        server_name _;

        # 本来のCloudFront以外からのオリジン直叩きを拒否する。
        # 運用でオリジンを直接叩いて切り分けたい場合は
        #   curl -H "X-Origin-Verify: <secret>" http://<eip>:3000/api/health
        # のようにヘッダーを付ける。
        if ($origin_verified = 0) {
            return 403;
        }

        # API requests -> Spring Boot
        location /api/ {
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cookie_path / "/; SameSite=Lax";
        }

        # ICS calendar file -> Spring Boot
        location /calendar.ics {
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # next/image は本アプリで一切使っていない (public/images は素の <img> で
        # 配信) が、output: 'standalone' の Next サーバは /_next/image を常に
        # 公開する。Next 14 系は 14.2.35 で打ち止めで、画像最適化APIの
        # RCE (GHSA-2xp9-vwfh-vxw4) を含む未修正CVEが残る。sharp 未導入かつ
        # remotePatterns 未設定なので現時点で実行経路は見つかっていないが、
        # 使っていない攻撃面なので塞いでおく (2026-10-21 の依存監査)。
        # Next を 15/16 に上げたら、この block は外して構わない。
        location /_next/image {
            return 404;
        }

        # Everything else -> Next.js frontend
        location / {
            proxy_pass http://frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
